<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd"
      extends="pagebuilder_base_form">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">kumar_interactive_hotspots_form.kumar_interactive_hotspots_form_data_source</item>
        </item>
    </argument>

    <settings>
        <deps>
            <dep>kumar_interactive_hotspots_form.kumar_interactive_hotspots_form_data_source</dep>
        </deps>
        <namespace>kumar_interactive_hotspots_form</namespace>
    </settings>

    <dataSource name="kumar_interactive_hotspots_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_PageBuilder/js/form/provider</item>
            </item>
        </argument>
        <dataProvider name="kumar_interactive_hotspots_form_data_source"
                      class="Magento\PageBuilder\Model\ContentType\DataProvider">
            <settings>
                <requestFieldName/>
                <primaryFieldName/>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">Interactive Hotspots</label>
        </settings>

        <field name="image" sortOrder="10" formElement="imageUploader">
            <settings>
                <label translate="true">Background image</label>
                <componentType>imageUploader</componentType>
                <dataType>string</dataType>
                <dataScope>image</dataScope>
                <notice translate="true">Upload the image on which hotspot points should be placed.</notice>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <allowedExtensions>jpg jpeg gif png webp</allowedExtensions>
                        <maxFileSize>10485760</maxFileSize>
                        <uploaderConfig>
                            <param xsi:type="string" name="url">kumar_interactivehotspots/image/upload</param>
                        </uploaderConfig>
                        <previewTmpl>Magento_PageBuilder/form/element/uploader/preview</previewTmpl>
                    </settings>
                </imageUploader>
            </formElements>
        </field>

        <field name="hotspots" sortOrder="20" formElement="textarea">
            <settings>
                <label translate="true">Hotspot data</label>
                <dataType>text</dataType>
                <dataScope>hotspots</dataScope>
                <visible>false</visible>
                <notice translate="true">Managed with the hotspot editor in the preview.</notice>
            </settings>
        </field>

        <field name="css_classes" sortOrder="30" formElement="input">
            <settings>
                <label translate="true">CSS classes</label>
                <dataType>text</dataType>
                <dataScope>css_classes</dataScope>
                <notice translate="true">Optional custom CSS classes.</notice>
                <imports>
                    <link name="value">ns = ${ $.namespace }, index = ${ $.index }:value</link>
                </imports>
            </settings>
        </field>
    </fieldset>
</form>